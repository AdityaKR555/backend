<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-800 min-h-screen p-15">
    <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded m-4" onclick="window.location.href='/'">Go back to home</button>
     <form id="edit-form" action="/edit" method="POST">
         <input type="text" name="prevtitle" value="<%= filename %>" class="block mb-2 p-3 border border-gray-300 rounded-lg w-full text-gray-400 bg-gray-900">
         <input type="text" name="newtitle" placeholder="New Title : Don't add extension" class="block mb-2 p-3 border border-gray-300 rounded-lg w-full text-white bg-gray-900">
         <input type="text" name="prevcontent" value="<%= content %>" class="block mb-2 p-3 border border-gray-300 rounded-lg w-full text-gray-400 bg-gray-900">
         <input type="text" name="newcontent" placeholder="New Content" class="block mb-2 p-3 border border-gray-300 rounded-lg w-full text-white bg-gray-900">
         
            <button type="submit" class="bg-blue-500 text-black hover:text-white hover:bg-blue-700 font-bold py-2 px-4 rounded-lg">
                Save Changes
            </button>
        </form>
</body>
</html>