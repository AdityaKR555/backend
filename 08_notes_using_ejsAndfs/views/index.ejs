<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-800 min-h-screen flex flex-col p-5">
    <h2 class="text-2xl font-bold mb-4 text-white">Notes & Notes Only</h2>
    <div id="notes-form">
        <form id="note-form" action="/create" method="POST">
            <input type="text" name="title" placeholder="Title" required class="block mb-2 p-3 border border-gray-300 rounded-lg w-full text-white bg-gray-900 placeholder:text-gray-200">
            <textarea name="content" placeholder="Content" required class="block mb-2 p-3 resize-none h-40 border border-gray-300 rounded-lg w-full text-white bg-gray-900 placeholder:text-gray-200"></textarea>
            <button type="submit" class="bg-blue-500 text-black hover:text-white hover:bg-blue-700 font-bold py-2 px-4 rounded-lg">
                Add Note
            </button>
        </form>
    </div>
   <div id="notes-container" class="mt-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

    <% if (files.length > 0) { %>

        <% files.forEach(file => { %>
            <div class="bg-gray-900 p-4 rounded-lg shadow-md shadow-white/20">
                <h3 class="text-xl font-semibold mb-2 text-white">
                    <%= file %>
                </h3>
                <div class="flex justify-between items-center px-1">
                <a href="/notes/<%= file %>" class="text-blue-500 hover:text-blue-700 cursor-pointer">
                    read more...
                </a>
                <a href="/edit/<%= file %>" class="text-yellow-500 hover:text-yellow-700 cursor-pointer ml-4">
                    edit file
                </a>
                </div>
            </div>
        <% }) %>

    <% } else { %>

        <p class="text-gray-300">No notes available.</p>

    <% } %>

</div>
</body>
</html>